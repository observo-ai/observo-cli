#!/usr/bin/env bash
# observo CLI installer.
#
#   curl -fsSL https://cli.observoai.co/install | bash
#   curl -fsSL https://cli.observoai.co/install | bash -s -- --version v0.1.0
#
# Detects OS + arch, downloads the matching binary from the GitHub
# Release, installs to $INSTALL_DIR (default /usr/local/bin if writable,
# otherwise ~/.local/bin).
#
# Source: https://github.com/observo-ai/observo-cli/blob/main/install.sh

set -euo pipefail

REPO="observo-ai/observo-cli"
INSTALL_DIR="${INSTALL_DIR:-}"
VERSION="latest"

# ---------------------------------------------------------------------
# Parse flags
# ---------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
  case "$1" in
    --version)
      VERSION="$2"; shift 2 ;;
    --install-dir)
      INSTALL_DIR="$2"; shift 2 ;;
    -h|--help)
      sed -n '2,12p' "$0" | sed 's/^# *//'; exit 0 ;;
    *)
      echo "unknown flag: $1" >&2; exit 2 ;;
  esac
done

# ---------------------------------------------------------------------
# Detect OS + arch (GoReleaser archive naming)
# ---------------------------------------------------------------------
case "$(uname -s)" in
  Darwin) OS="Darwin" ;;
  Linux)  OS="Linux"  ;;
  *)      echo "unsupported OS: $(uname -s). Use https://github.com/observo-ai/observo-cli/releases manually." >&2; exit 1 ;;
esac

case "$(uname -m)" in
  x86_64|amd64) ARCH="x86_64" ;;
  arm64|aarch64) ARCH="arm64" ;;
  *) echo "unsupported arch: $(uname -m)" >&2; exit 1 ;;
esac

# ---------------------------------------------------------------------
# Resolve version
# ---------------------------------------------------------------------
if [[ "$VERSION" == "latest" ]]; then
  # GH provides a redirect from /releases/latest to the actual tag; we
  # follow it without authenticating (works for public repos).
  REDIRECT=$(curl -fsSLI -o /dev/null -w '%{url_effective}' "https://github.com/$REPO/releases/latest")
  VERSION="${REDIRECT##*/}"
  if [[ -z "$VERSION" || "$VERSION" == "latest" ]]; then
    echo "could not resolve latest version" >&2; exit 1
  fi
fi
VERSION_NO_V="${VERSION#v}"

# ---------------------------------------------------------------------
# Pick install dir — prefer /usr/local/bin if writable
# ---------------------------------------------------------------------
if [[ -z "$INSTALL_DIR" ]]; then
  if [[ -w "/usr/local/bin" ]]; then
    INSTALL_DIR="/usr/local/bin"
  else
    INSTALL_DIR="$HOME/.local/bin"
    mkdir -p "$INSTALL_DIR"
  fi
fi

# ---------------------------------------------------------------------
# Download + extract
# ---------------------------------------------------------------------
ARCHIVE="observo_${VERSION_NO_V}_${OS}_${ARCH}.tar.gz"
URL="https://github.com/$REPO/releases/download/${VERSION}/${ARCHIVE}"

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

echo "observo: downloading $URL"
curl -fsSL -o "$TMP/$ARCHIVE" "$URL"

tar -xzf "$TMP/$ARCHIVE" -C "$TMP" observo
chmod +x "$TMP/observo"

install "$TMP/observo" "$INSTALL_DIR/observo"
echo "observo: installed to $INSTALL_DIR/observo"

# ---------------------------------------------------------------------
# Smoke test + PATH hint
# ---------------------------------------------------------------------
"$INSTALL_DIR/observo" --version | head -n 1
if [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
  echo
  echo "warning: $INSTALL_DIR is not on your \$PATH"
  echo "  bash: echo 'export PATH=\"$INSTALL_DIR:\$PATH\"' >> ~/.bashrc"
  echo "  zsh:  echo 'export PATH=\"$INSTALL_DIR:\$PATH\"' >> ~/.zshrc"
fi
